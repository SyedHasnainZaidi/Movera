{
  "trunk-flexion": {
    "sideMode": "FACING",
    "recommendedView": "SIDE",
    "ruleConfig": {
      "version": 1,
      "requiredLandmarks": [
        "nose",
        "{side}_shoulder",
        "{side}_hip",
        "{side}_knee",
        "{side}_ankle"
      ],
      "angleDefinitions": {
        "trunkFlexion": {
          "type": "signed_tilt",
          "pivot": "{side}_hip",
          "end": "{side}_shoulder",
          "reference": "up",
          "facing": [
            "{side}_shoulder",
            "nose"
          ],
          "positive": "forward"
        },
        "knee": {
          "type": "joint",
          "a": "{side}_hip",
          "b": "{side}_knee",
          "c": "{side}_ankle"
        },
        "_shoulderWidth": {
          "type": "gap_x",
          "a": "left_shoulder",
          "b": "right_shoulder"
        },
        "_torsoLength": {
          "type": "distance",
          "a": "{side}_shoulder",
          "b": "{side}_hip"
        },
        "_frontalRatio": {
          "type": "ratio",
          "numerator": "_shoulderWidth",
          "denominator": "_torsoLength"
        },
        "_facingGap": {
          "type": "confidence_gap",
          "subject": [
            "{side}_shoulder",
            "{side}_hip",
            "{side}_knee"
          ],
          "other": [
            "{other}_shoulder",
            "{other}_hip",
            "{other}_knee"
          ]
        }
      },
      "movementStateConfig": {
        "primaryAngle": "trunkFlexion",
        "direction": "INCREASING",
        "restAngle": 15,
        "peakAngle": 45,
        "hysteresisDeg": 6,
        "minStateFrames": 3,
        "cooldownMs": 800,
        "minRepDurationMs": 1200,
        "maxRepDurationMs": 20000,
        "cues": {
          "IDLE": "Stand tall, {side} side towards the camera, to begin.",
          "UP": "Slowly bend forward from your hips.",
          "GOING_DOWN": "Keep bending forward - move further.",
          "DOWN": "Movement completed - now slowly return to standing.",
          "GOING_UP": "Return to the upright starting position.",
          "REP": "Repetition complete - stand tall before the next one."
        }
      },
      "postureRules": [
        {
          "code": "INCOMPLETE_ROM",
          "angle": "trunkFlexion",
          "when": "at_peak",
          "min": 50,
          "joint": "trunk",
          "message": "Move further - bend a little more forward from your hips."
        },
        {
          "code": "KNEE_FLEXED",
          "angle": "knee",
          "when": "always",
          "min": 150,
          "joint": "knee",
          "message": "Keep your knees almost straight - bend from your hips, not your knees."
        },
        {
          "code": "TRUNK_LEAN",
          "angle": "trunkFlexion",
          "when": "always",
          "min": -15,
          "joint": "trunk",
          "message": "Avoid leaning backwards - return only as far as upright."
        },
        {
          "gate": true,
          "code": "WRONG_CAMERA_VIEW",
          "angle": "_frontalRatio",
          "max": 0.45,
          "message": "Incorrect camera position - stand side-on, with your {side} shoulder pointing at the camera. Counting is paused."
        },
        {
          "gate": true,
          "code": "WRONG_SIDE_FACING",
          "angle": "_facingGap",
          "max": 0.2,
          "message": "Turn around - your {side} side must face the camera for the forward bend. Counting is paused."
        }
      ],
      "minVisibility": 0.5,
      "repCorrectnessThreshold": 70
    }
  },
  "neck-side-bend": {
    "sideMode": "DIRECTION",
    "recommendedView": "FRONT",
    "ruleConfig": {
      "version": 1,
      "requiredLandmarks": [
        "nose",
        "left_eye",
        "right_eye",
        "left_shoulder",
        "right_shoulder",
        "left_hip",
        "right_hip"
      ],
      "angleDefinitions": {
        "neckTilt": {
          "type": "line_tilt",
          "a": "right_eye",
          "b": "left_eye",
          "refA": "right_shoulder",
          "refB": "left_shoulder",
          "towards": "{side}"
        },
        "trunkTilt": {
          "type": "vertical",
          "upper": "mid_shoulder",
          "lower": "mid_hip"
        },
        "_shoulderWidth": {
          "type": "gap_x",
          "a": "left_shoulder",
          "b": "right_shoulder"
        },
        "_torsoLength": {
          "type": "distance",
          "a": "mid_shoulder",
          "b": "mid_hip"
        },
        "_frontalRatio": {
          "type": "ratio",
          "numerator": "_shoulderWidth",
          "denominator": "_torsoLength"
        },
        "_shoulderDrop": {
          "type": "gap_y",
          "a": "left_shoulder",
          "b": "right_shoulder"
        },
        "_shoulderLevel": {
          "type": "ratio",
          "numerator": "_shoulderDrop",
          "denominator": "_shoulderWidth"
        }
      },
      "movementStateConfig": {
        "primaryAngle": "neckTilt",
        "direction": "INCREASING",
        "restAngle": 5,
        "peakAngle": 15,
        "hysteresisDeg": 3,
        "minStateFrames": 2,
        "cooldownMs": 700,
        "minRepDurationMs": 1000,
        "maxRepDurationMs": 15000,
        "cues": {
          "IDLE": "Face the camera with your head upright to begin.",
          "UP": "Slowly tilt your {side} ear towards your {side} shoulder.",
          "GOING_DOWN": "Keep tilting - move further, ear towards shoulder.",
          "DOWN": "Movement completed - now bring your head back to the centre.",
          "GOING_UP": "Return your head to upright.",
          "REP": "Repetition complete - head upright before the next one."
        }
      },
      "postureRules": [
        {
          "code": "INCOMPLETE_ROM",
          "angle": "neckTilt",
          "when": "at_peak",
          "min": 17,
          "joint": "neck",
          "message": "Move further - bring your {side} ear a little closer to your shoulder."
        },
        {
          "code": "WRONG_SIDE_MOVEMENT",
          "angle": "neckTilt",
          "when": "always",
          "min": -10,
          "joint": "neck",
          "message": "Movement detected on the wrong side - you are tilting towards your {other} shoulder. This session is for the {side} side."
        },
        {
          "code": "SHOULDER_HITCH",
          "angle": "_shoulderLevel",
          "when": "always",
          "max": 0.15,
          "joint": "shoulder",
          "message": "Keep your shoulders relaxed and level - don't lift a shoulder towards your ear."
        },
        {
          "code": "TRUNK_COMPENSATION",
          "angle": "trunkTilt",
          "when": "always",
          "max": 8,
          "joint": "trunk",
          "message": "Keep your torso upright and still - bend only your neck, not your whole body."
        },
        {
          "gate": true,
          "code": "WRONG_CAMERA_VIEW",
          "angle": "_frontalRatio",
          "min": 0.5,
          "message": "Incorrect camera position - face the camera directly with both shoulders in view. Counting is paused."
        }
      ],
      "minVisibility": 0.5,
      "repCorrectnessThreshold": 70
    }
  },
