# ---------------------------------------------------------------------------
# Pose service environment. Copy to .env and fill in.
#
# The two secrets MUST match the backend's values exactly - they are how the
# two services authenticate each other.
# ---------------------------------------------------------------------------

POSE_ENVIRONMENT=development
POSE_SERVICE_PORT=8000
POSE_LOG_LEVEL=INFO

# --- Shared secrets (must equal the backend's) ---------------------------
# Verifies the short-lived ticket the browser presents on the WebSocket.
POSE_TICKET_SECRET=CHANGE_ME_must_match_backend_POSE_TICKET_SECRET
# Presented on outbound calls to the backend's /internal endpoints.
POSE_SERVICE_TOKEN=CHANGE_ME_must_match_backend_POSE_SERVICE_TOKEN

# Docker compose: http://backend:3000
BACKEND_INTERNAL_URL=http://localhost:3000

# Browser origins allowed to open the frame WebSocket. Never "*".
ALLOWED_ORIGINS=http://localhost:5173

# --- Model ---------------------------------------------------------------
# Fetch with: python scripts/download_model.py --variant full
POSE_MODEL_PATH=app/pose/model/yolov8n-pose.pt
# 2, not 1: MULTIPLE_PEOPLE cannot be detected if only one pose is requested.
POSE_NUM_POSES=2
POSE_MIN_DETECTION_CONFIDENCE=0.5
POSE_MIN_PRESENCE_CONFIDENCE=0.5
POSE_MIN_TRACKING_CONFIDENCE=0.5

# --- Analysis tuning -----------------------------------------------------
# Minimum per-landmark visibility for a landmark to count as present.
LANDMARK_VISIBILITY_THRESHOLD=0.5
# Rolling-median window over joint angles (frames).
POSE_SMOOTHING_WINDOW=5

# --- Limits --------------------------------------------------------------
POSE_MAX_FRAME_BYTES=2000000
POSE_SESSION_TTL_SECONDS=900
POSE_MAX_CONCURRENT_SESSIONS=8
POSE_MAX_SESSION_MINUTES=120
