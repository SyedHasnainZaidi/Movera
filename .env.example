# ---------------------------------------------------------------------------
# Root environment - used by docker-compose.yml (the LOCAL full stack).
#
# For the EC2 deployment use .env.production.example instead.
#
# Running natively without Docker? Each app has its own .env.example:
#   apps/backend/.env.example
#   apps/frontend/.env.example
#   services/pose-service/.env.example
#
# Copy this file to .env and fill in the secrets. Compose refuses to start
# without them - there are deliberately no defaults for secrets.
#
# Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------

# --- mode -----------------------------------------------------------------
# `production` is the default and requires working SMTP credentials below.
# Set `development` for a local run with no mail server: every message is
# written to the backend log instead of sent, so a verification or reset link
# can be copied straight out of `docker compose logs backend`.
NODE_ENV=production
POSE_ENVIRONMENT=production

# --- database -------------------------------------------------------------
POSTGRES_USER=physio
POSTGRES_PASSWORD=physio_dev_password
POSTGRES_DB=physio

# --- application tokens ---------------------------------------------------
# Minimum 32 characters each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- pose service boundary ------------------------------------------------
# POSE_TICKET_SECRET signs the short-lived ticket the browser presents to the
# pose service. POSE_SERVICE_TOKEN authenticates the pose service when it calls
# the backend's /internal endpoints. Both are shared by the two services and
# must be identical on each side.
POSE_TICKET_SECRET=
POSE_SERVICE_TOKEN=

# --- browser-facing URLs --------------------------------------------------
# These are what the BROWSER uses. They are NOT the compose-internal hostnames
# (backend:3000 / pose-service:8000), which only resolve inside the Docker
# network. Vite bakes the VITE_* values into the bundle at build time.
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1
VITE_POSE_WS_URL=ws://localhost:8000/ws/session

# --- frame sampling -------------------------------------------------------
# YOLOv8n-pose costs roughly 140 ms per frame on a 4-core CPU, so the detector
# tops out near 7 fps. Sampling faster only fills the socket with frames that
# backpressure then drops.
VITE_POSE_FRAME_SAMPLE_FPS=7
VITE_POSE_IMAGE_WIDTH=480
VITE_POSE_IMAGE_QUALITY=0.6

# --- limits ---------------------------------------------------------------
POSE_MAX_CONCURRENT_SESSIONS=8

# --- proxy / cookies ------------------------------------------------------
# Both stay false locally: nothing proxies in front of the local stack, and it
# is served over plain HTTP. Trusting X-Forwarded-For with no proxy present
# would let any client forge its own source address past the rate limiter.
TRUST_PROXY=false
COOKIE_SECURE=false

# --- Email (Gmail SMTP) ---------------------------------------------------
# REQUIRED when NODE_ENV=production - the backend refuses to start without it,
# because an unsendable verification email locks every new account out of
# itself permanently. Leave blank and set NODE_ENV=development instead for a
# local run.
#
# Gmail needs an APP PASSWORD, not the account password:
#   1. Enable 2-Step Verification on the Google account.
#   2. Google Account > Security > 2-Step Verification > App passwords.
#   3. Generate one for "Mail" and paste the 16 characters into SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Movera <no-reply@movera.local>
