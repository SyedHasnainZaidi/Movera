# ---------------------------------------------------------------------------
# Root environment - used ONLY by docker-compose.yml.
#
# Running natively? Each app has its own .env.example instead:
#   apps/backend/.env.example
#   apps/frontend/.env.example
#   services/pose-service/.env.example
#
# Copy this file to .env and fill in the four secrets. Compose will refuse to
# start without them - there are deliberately no defaults for secrets.
#
# Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------

# --- database -------------------------------------------------------------
POSTGRES_USER=physio
POSTGRES_PASSWORD=physio_dev_password
POSTGRES_DB=physio

# --- application tokens ---------------------------------------------------
# Minimum 32 characters each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- pose service boundary ------------------------------------------------
# POSE_TICKET_SECRET signs the short-lived ticket the browser presents to the
# pose service. POSE_SERVICE_TOKEN authenticates the pose service when it calls
# the backend's /internal endpoints. Both are shared by the two services and
# must be identical on each side.
POSE_TICKET_SECRET=
POSE_SERVICE_TOKEN=

# --- browser-facing URLs --------------------------------------------------
# These are what the BROWSER uses. They are NOT the compose-internal hostnames
# (backend:3000 / pose-service:8000), which only resolve inside the Docker
# network. Vite bakes the VITE_* values into the bundle at build time.
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1
VITE_POSE_WS_URL=ws://localhost:8000/ws/session

# --- frame sampling -------------------------------------------------------
# Measured MediaPipe inference on a real photo is ~65 ms per frame on CPU, so
# ~15 fps is the practical ceiling. 10 fps leaves headroom.
VITE_POSE_FRAME_SAMPLE_FPS=10
VITE_POSE_IMAGE_WIDTH=480
VITE_POSE_IMAGE_QUALITY=0.6

# --- limits ---------------------------------------------------------------
POSE_MAX_CONCURRENT_SESSIONS=8

# true only when the stack is served over HTTPS.
COOKIE_SECURE=false
