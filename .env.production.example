# ---------------------------------------------------------------------------
# Production environment for the EC2 deployment.
#
#   cp .env.production.example .env
#   # fill in every value below, then:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Every entry here has no default in compose: a missing one stops the stack at
# start-up with a named error rather than booting something half-configured.
#
# Generate each secret with:
#   openssl rand -hex 48
# ---------------------------------------------------------------------------

# --- public hostname ------------------------------------------------------
# An A record pointing at this instance's Elastic IP. Caddy requests a
# certificate for exactly this name on first start, so DNS must already
# resolve or issuance fails.
API_DOMAIN=api.movera.example.com
# Let's Encrypt sends expiry warnings here.
ACME_EMAIL=you@example.com

# --- frontend origin ------------------------------------------------------
# The Vercel deployment. Exact scheme and host, NO trailing slash - it is
# compared verbatim against the browser's Origin header for both CORS and the
# pose WebSocket handshake. Comma-separate if a preview domain also needs in.
FRONTEND_URL=https://movera.vercel.app

# Base URL for links inside verification and password-reset emails. Leave
# blank to use the first FRONTEND_URL entry, which is correct here.
APP_PUBLIC_URL=

# --- database -------------------------------------------------------------
# Not the local development password. This database is never published to the
# host, but the credential still travels the compose network.
POSTGRES_USER=movera
POSTGRES_PASSWORD=
POSTGRES_DB=movera

# --- application tokens ---------------------------------------------------
# Minimum 32 characters each. Four DISTINCT values - reusing one across two
# purposes means a token minted for one service can be replayed against the
# other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- pose service boundary ------------------------------------------------
# Shared by the backend and the pose service. Byte-identical on both sides or
# every session is rejected at the WebSocket handshake.
POSE_TICKET_SECRET=
POSE_SERVICE_TOKEN=

# --- Email ----------------------------------------------------------------
# Mandatory. The backend will not start without all three.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Movera <no-reply@movera.example.com>

# --- capacity -------------------------------------------------------------
# One YOLOv8n frame is ~140 ms of CPU. A 2-vCPU instance sustains roughly
# 7 fps in total, and the frontend samples at 7 fps per patient - so this is
# already oversubscribed at 3. Raise it only with more vCPU.
POSE_MAX_CONCURRENT_SESSIONS=3
POSE_MAX_SESSION_MINUTES=120

# --- logging / limits -----------------------------------------------------
LOG_LEVEL=log
POSE_LOG_LEVEL=INFO
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ---------------------------------------------------------------------------
# NOT set here, on purpose:
#
#   TRUST_PROXY / COOKIE_SECURE  - hard-coded to true in docker-compose.prod.yml.
#                                  Both are required for a Vercel frontend and
#                                  neither is a per-environment choice.
#   VITE_*                       - the frontend is built by Vercel, not here.
#                                  Set these in the Vercel project instead:
#                                    VITE_API_URL     https://$API_DOMAIN/api/v1
#                                    VITE_POSE_WS_URL wss://$API_DOMAIN/ws/session
# ---------------------------------------------------------------------------
