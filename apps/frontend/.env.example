NODE_ENV=development

# Backend REST API.
VITE_API_URL=http://localhost:3000/api/v1

# FastAPI pose service WebSocket. Must be wss:// in production.
VITE_POSE_WS_URL=ws://localhost:8000/ws/session

# Frame sampling. 10 fps at 480px is comfortable against a measured
# ~30 ms MediaPipe inference time, and keeps each frame around 25-40 KB.
# 7, not 10: YOLOv8n-pose costs ~140 ms per frame on a 4-core CPU, so the
# detector tops out near 7 fps. Sampling faster only fills the socket with
# frames that backpressure then drops, burning phone/laptop battery for
# nothing. The MediaPipe detector this replaced ran at ~65 ms and could
# sustain 10.
VITE_POSE_FRAME_SAMPLE_FPS=7
VITE_POSE_IMAGE_WIDTH=480
VITE_POSE_IMAGE_QUALITY=0.6
