# ---------------------------------------------------------------------------
# Backend environment. Copy to .env and fill in.
#
# There are NO fallback values in code: a missing secret crashes the process at
# boot rather than silently starting with a predictable key.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=log

# Local PostgreSQL (the primary setup).
#
# Create the role and database once, as the postgres superuser. The full
# procedure - generating the password, filling the template, and running it -
# is documented at the top of scripts/bootstrap-local-db.sql. In short:
#
#   psql -U postgres -h 127.0.0.1 -p 5432 -f .pgdump/bootstrap-local-db.sql
#
# psql prompts for the superuser password, so it never reaches a file or the
# shell history.
DATABASE_URL="postgresql://physio:CHANGE_ME_the_password_you_generated@127.0.0.1:5432/physio?schema=public"

# Fallbacks, for a machine with no local PostgreSQL server:
#   embedded-postgres:  npm run db:up  ->  prints a URL on port 55432
#   docker compose:     postgresql://physio:physio@postgres:5432/physio?schema=public

# Comma-separated browser origins allowed by CORS. Never "*".
FRONTEND_URL=http://localhost:5173

# --- Application tokens ---------------------------------------------------
# Minimum 32 characters each. Access is short-lived and held in browser memory;
# refresh is opaque, rotated on every use, and delivered as an HttpOnly cookie.
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_64_char_random_hex_string_for_access_tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_64_char_random_hex_string_for_refresh_tokens
JWT_REFRESH_EXPIRES_IN=7d

# --- Pose service boundary ------------------------------------------------
# Signs the short-lived ticket the browser presents to the FastAPI pose
# service. Deliberately a DIFFERENT secret from JWT_ACCESS_SECRET so neither
# token can be replayed against the other service.
POSE_TICKET_SECRET=CHANGE_ME_generate_a_64_char_random_hex_string_for_pose_tickets
POSE_TICKET_EXPIRES_IN=2m

# Shared secret for the pose-service -> backend internal channel (rep ingest,
# session activation). This token authorises writes to clinical records.
POSE_SERVICE_TOKEN=CHANGE_ME_generate_a_64_char_random_hex_string_for_internal_calls

# Backend -> pose service, used only for health checks.
# Docker compose: http://pose-service:8000
POSE_SERVICE_URL=http://localhost:8000

# --- Lifecycle ------------------------------------------------------------
INVITE_CODE_TTL_MINUTES=60
CREATED_SESSION_TTL_MINUTES=15
ACTIVE_SESSION_TTL_MINUTES=120

# --- Hardening ------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
# true only when served over HTTPS
COOKIE_SECURE=false
REFRESH_COOKIE_PATH=/api/v1/auth

# --- Branding -------------------------------------------------------------
APP_NAME=Movera
# Base URL used for links inside emails. Optional: defaults to the first
# FRONTEND_URL entry, which is correct for a standard local setup. Set it when
# the browser reaches the app on a different host from the CORS origin.
# APP_PUBLIC_URL=http://localhost:5173

# --- Email (Gmail SMTP) ---------------------------------------------------
# OPTIONAL in development. Left blank, the backend does not send mail: every
# message is written to its log instead, so a verification or reset link can be
# copied straight out of the terminal. REQUIRED when NODE_ENV=production - the
# process refuses to start without it, because silently not sending a
# verification email locks every new user out of their own account.
#
# Gmail needs an APP PASSWORD, not the account password:
#   1. Enable 2-Step Verification on the Google account.
#   2. Google Account > Security > 2-Step Verification > App passwords.
#   3. Generate one for "Mail" and paste the 16 characters into SMTP_PASSWORD.
# Port 587 uses STARTTLS; port 465 uses implicit TLS. Both work with Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Movera <no-reply@movera.local>

EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
